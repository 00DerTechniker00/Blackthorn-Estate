{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/materials.mjs": {
      "includeFiles": "shared-plan.json",
      "maxDuration": 15
    },
    "api/build-progress.mjs": {
      "includeFiles": "live-plan.json",
      "maxDuration": 15
    },
    "api/build-plan.mjs": {
      "includeFiles": "{live-plan.json,live-server-plan.tsv.gz}",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
