# Only set these values as server environment variables in Vercel.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR-UPSTASH-REST-TOKEN
SHARED_LIST_TEAM_CODE=GENERATE-A-RANDOM-CODE-OF-AT-LEAST-16-CHARACTERS
# Optional. Keep this name stable across deployments so the list persists.
SHARED_LIST_NAMESPACE=blackthorn:materials:v1
